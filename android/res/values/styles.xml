<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme for API 21+ (minSdk). No bar-color attrs here — they are
         set programmatically in MainActivity to avoid crashes on API 35+
         where statusBarColor / navigationBarColor are deprecated & removed. -->
    <style name="Theme.Vyro" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/vyro_bg</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
